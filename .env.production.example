# SERVERDA loyiha ildizida `.env` nomi bilan saqlang (shu fayldan nusxa oling).
# Bu fayl docker-compose.prod.yml uchun. Haqiqiy .env ni gitga qo'shmang.
# Qiymatlarda `$`, `#` va bo'sh joy ishlatmang (Docker ularni noto'g'ri o'qiydi).

# Sizning domeningiz, "https://" va "www." siz. Masalan: penaura.uz
# DNS da ikkita yozuv bo'lishi kerak: DOMAIN va admin.DOMAIN (ikkalasi ham server IP manziliga).
DOMAIN=penaura.uz

POSTGRES_DB=penaura
POSTGRES_USER=penaura_user
# Uzun tasodifiy parol. Serverda yaratish: openssl rand -hex 24
POSTGRES_PASSWORD=
