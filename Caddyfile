# Production: Caddy avtomatik HTTPS (Let's Encrypt) beradi.
# Domen .env dagi DOMAIN o'zgaruvchisidan olinadi (masalan, DOMAIN=penaura.uz).
# DNS da ikkala yozuv ham shu serverning IP manziliga qaratilgan bo'lishi kerak:
#   penaura.uz         -> sayt
#   admin.penaura.uz   -> admin panel

(common) {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
    -Server
  }
  # Manba kod va maxfiy fayllar tasodifan ochilib qolmasin
  @private path_regexp private \.(py|md|bak|env|sh|yml|yaml)$
  handle @private {
    respond 404
  }
}

(assets-cache) {
  @assets path *.css *.js *.png *.jpg *.jpeg *.webp *.svg *.ico *.woff2
  header @assets Cache-Control "public, max-age=3600"
}

# ---------- Sayt ----------
{$DOMAIN} {
  import common

  handle /api/* {
    request_body {
      max_size 20MB
    }
    reverse_proxy backend:8000
  }

  # Django admin (/admin/): Django'ning o'z login'i bilan himoyalangan (faqat superuser/staff kira oladi).
  # Cheklash uchun (faqat o'z IP'ingiz): handle ichida `@me remote_ip SIZNING_IP` qo'shing.
  handle /admin/* {
    reverse_proxy backend:8000
  }
  handle_path /static/* {
    root * /srv/static
    file_server
  }
  handle_path /media/* {
    root * /srv/media
    file_server
  }

  handle {
    root * /srv/frontend
    import assets-cache
    file_server
  }
}

# ---------- www -> asosiy domenga yo'naltirish ----------
www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}

# ---------- Admin panel (direktor, tahrirchi, moderator, moliyachi) ----------
admin.{$DOMAIN} {
  import common

  handle /api/* {
    request_body {
      max_size 20MB
    }
    reverse_proxy backend:8000
  }

  handle {
    root * /srv/admin
    @home path /
    rewrite @home /dashboard.html
    import assets-cache
    file_server
  }
}