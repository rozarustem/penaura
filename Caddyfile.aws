# AWS: HTTPS ni Application Load Balancer tugatadi, Caddy faqat HTTP (80) da ishlaydi.
# ALB Host sarlavhasini saqlaydi: penaura.uz -> sayt, admin.penaura.uz -> admin panel.
# /health -> ALB Target Group health check (200 OK).
{
  auto_https off
  admin off
  # ALB (VPC ichki tarmog'i) ishonchli proksi: X-Forwarded-Proto/For sarlavhalari saqlansin,
  # aks holda Django har doim "http" ko'rib, https ga cheksiz yo'naltiradi.
  servers {
    trusted_proxies static private_ranges
  }
}

(common) {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
    -Server
  }
  @private path_regexp private \.(py|md|bak|env|sh|yml|yaml)$
  handle @private {
    respond 404
  }
}

(assets-cache) {
  @assets path *.css *.js *.png *.jpg *.jpeg *.webp *.svg *.ico *.woff2
  header @assets Cache-Control "public, max-age=3600"
}

:80 {
  # ALB health check (Host sarlavhasiga bog'liq emas)
  handle /health {
    respond "ok" 200
  }

  # Admin panel: admin.* host
  @adminhost header_regexp host Host ^admin\.
  handle @adminhost {
    import common
    handle /api/* {
      request_body {
        max_size 20MB
      }
      reverse_proxy backend:8000
    }
    handle {
      root * /srv/admin
      @home path /
      rewrite @home /dashboard.html
      import assets-cache
      file_server
    }
  }

  # Asosiy sayt
  handle {
    import common

    handle /api/* {
      request_body {
        max_size 20MB
      }
      reverse_proxy backend:8000
    }

    handle /admin/* {
      reverse_proxy backend:8000
    }

    handle_path /static/* {
      root * /srv/static
      file_server
    }

    handle {
      root * /srv/frontend
      import assets-cache
      file_server
    }
  }
}
