# backend/.env fayliga nusxalang va qiymatlarni to'ldiring. Haqiqiy .env ni gitga qo'shmang.

# Yangi kalit olish: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Parolni tiklash xatlari uchun Gmail (oddiy parol emas, "Ilova paroli" kerak)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# PostgreSQL (Docker ichida docker-compose.yml bularni o'zi almashtiradi)
DB_NAME=penaura
DB_USER=penaura_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Demo to'lov: PAYMENTS_MOCK=True bo'lsa va (DEBUG=True yoki DEMO_MODE=True) bo'lsagina ishlaydi.
PAYMENTS_MOCK=True
# Internetdagi DEMO serverda (DEBUG=False bilan) sinov to'lovini yoqish uchun. Haqiqiy pulli saytda False qoldiring.
DEMO_MODE=False

# Productionda:
# DEBUG=False
# DEMO_MODE=True   (faqat demo uchun; sinov to'lovi ishlashi uchun)
# ALLOWED_HOSTS=penaura.uz,api.penaura.uz
# CORS_ALLOWED_ORIGINS=https://penaura.uz,https://admin.penaura.uz
# CSRF_TRUSTED_ORIGINS=https://api.penaura.uz
# FRONTEND_URL=https://penaura.uz/
# BEHIND_PROXY=True
# SECURE_HSTS_SECONDS=31536000