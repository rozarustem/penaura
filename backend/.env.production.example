    # SERVERDA backend/.env.production nomi bilan saqlang (shu fayldan nusxa oling).
# Haqiqiy faylni gitga qo'shmang. Qiymatlarda `$`, `#` va bo'sh joy ishlatmang.
#
# DEBUG, ALLOWED_HOSTS, CORS, CSRF, FRONTEND_URL, BEHIND_PROXY va baza sozlamalarini
# docker-compose.prod.yml o'zi qo'yadi (domen ildizdagi .env dagi DOMAIN dan olinadi).

# Django maxfiy kaliti. YANGI yarating (eski kalitni ishlatmang): openssl rand -hex 40
SECRET_KEY=

# Email (ro'yxatdan o'tishda tasdiqlash kodi va parolni tiklash uchun SHART).
# Gmail > Xavfsizlik > "Ilova parollari" bo'limida YANGI parol yarating (nomi, masalan: penaura-server).
# Parolni bo'sh joylarsiz yozing (16 ta harf).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Penaura <sizning-pochtangiz@gmail.com>

# DEMO server: haqiqiy pul yo'q, sinov to'lovi bepul tanga beradi.
# Haqiqiy pulli saytga o'tganda DEMO_MODE ni o'chiring va Click kalitlarini yozing.
DEMO_MODE=True
PAYMENTS_MOCK=True

# HTTPS ishlayotganini tekshirgach (taxminan 1 hafta) 31536000 qilishingiz mumkin.
# Hozircha 0 qoldiring: xato bo'lsa brauzerlar HTTPS ni "eslab qolmaydi".
SECURE_HSTS_SECONDS=0

# Ixtiyoriy (standart qiymatlar):
# WRITER_SHARE_PERCENT=70
# COIN_RATE_SOM=1500
# MIN_WITHDRAWAL_SOM=10000
# DIRECTOR_APPROVAL_SOM=500000
